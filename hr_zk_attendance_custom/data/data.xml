<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- cron job for attendance synchronization -->
        <record id="ir_cron_attendance_sync" model="ir.cron">
            <field name="name">Attendance Sync</field>
            <field name="model_id" ref="hr_zk_attendance_custom.model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.action_download_attendance()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
        </record>

        <!-- cron job for resync attendance -->
        <record id="ir_cron_resync_attendance" model="ir.cron">
            <field name="name">Resync Attendance</field>
            <field name="model_id" ref="hr_zk_attendance_custom.model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.action_resync_hr_attendance()</field>
            <field name="interval_number">11</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>

