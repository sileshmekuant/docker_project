<odoo>
    <template id="report_fuel_consumption">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4">Fleet Fuel Report</h2>

                        <div class="container">
                            <div class="mb-4 row">
                                <div class="col-6">
                                    <p>
                                        <strong>Reference:</strong>
                                        <u><t t-esc="doc.name" /></u>
                                    </p>
                                    <p>
                                        <strong>Start Date:</strong>
                                        <u><t t-esc="doc.start_date" /></u>
                                    </p>
                                </div>
                                <div class="col-6">
                                    <p>
                                        <strong>End Date:</strong>
                                        <u><t t-esc="doc.end_date" /></u>
                                    </p>
                                    <p>
                                        <strong>Vehicle:</strong>
                                        <u><t t-esc="doc.vehicle.name or 'All Vehicles'" /></u>
                                    </p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <table class="table">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Ref</th>
                                            <th scope="col">Date</th>
                                            <th scope="col">Warehouse</th>
                                            <th scope="col">Qty Dispensed</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="counter" t-value="1" />
                                        <t t-foreach="doc.vehicles_consumption" t-as="cons">
                                            <tr>
                                                <th scope="row"><t t-esc="counter" /></th>
                                                <td><t t-esc="cons.name" /></td>
                                                <td><t t-esc="cons.date" /></td>
                                                <td><t t-esc="cons.warehouse_id.name" /></td>
                                                <td><t t-esc="cons.dispense_fuel" /></td>
                                            </tr>
                                            <t t-set="counter" t-value="counter + 1" />
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_fuel_request" model="ir.actions.report">
        <field name="name">Fuel Report</field>
        <field name="model">fuel.consumption.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fuels_request.report_fuel_consumption</field>
        <field name="report_file">fuels_request.report_fuel_consumption</field>
        <field name="print_report_name">'Fuel Report - %s' % object.name</field>
        <field name="binding_model_id" ref="model_fuel_consumption_report" />
        <field name="binding_type">report</field>
    </record>
</odoo>
