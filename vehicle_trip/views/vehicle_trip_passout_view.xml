<odoo>
    <record id="view_vehicle_trip_printout_form" model="ir.ui.view">
        <field name="name">vehicle.trip.printout.form</field>
        <field name="model">vehicle.trip.printout</field>
        <field name="arch" type="xml">
            <form string="Vehicle Trip Printout">
                <sheet>
                    <group string="General">
                        <field name="vehicle" readonly="1"/>
                        <field name="plate_number"/>
                        <field name="driver_name"/>
                        <field name="start_location"/>
                        <field name="date" readonly="1"/>
                        <field name="destination_location" readonly="1"/>
                        <field name="start_date" readonly="1"/>
                        <field name="end_date"/>
                        <!-- <field name="total_duration"/> -->
                        <field name="reason"/>
                    </group>
                    <group string="Requester">
                        <field name="requester_name"/>
                        <field name="requester_title"/>
                        <!-- <field name="requester_signature"/> -->
                    </group>
                    <group string="Authorizer">
                        <field name="authorizer_name"/>
                        <field name="authorizer_title"/>
                        <!-- <field name="authorizer_signature"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_vehicle_trip_printout_tree" model="ir.ui.view">
        <field name="name">vehicle.trip.printout.tree</field>
        <field name="model">vehicle.trip.printout</field>
        <field name="arch" type="xml">
            <tree string="gate pass">
                <field name="vehicle"/>
                <field name="plate_number"/>
                <field name="driver_name"/>
                <field name="start_location"/>
                <field name="date"/>
                <field name="destination_location"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <!-- <field name="total_duration"/> -->
                <field name="requester_name"/>
                <field name="authorizer_name"/>
            </tree>
        </field>
    </record>


    <record id="action_vehicle_trip_printout" model="ir.actions.act_window">
        <field name="name">gate pass</field>
        <field name="res_model">vehicle.trip.printout</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="menu_vehicle_trip_printout"
          name="Gate pass"
          parent="fleet.menu_root"
          action="action_vehicle_trip_printout"
          sequence="30"/>
</odoo>
