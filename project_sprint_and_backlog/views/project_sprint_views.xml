<odoo>
  <!-- Form View -->
  <record id="view_project_sprint_form" model="ir.ui.view">
    <field name="name">project.sprint.form</field>
    <field name="model">project.sprint</field>
    <field name="arch" type="xml">
      <form string="Sprint">
        <group>
          <field name="name"/>
          <field name="project_id"/>
          <field name="start_date"/>
          <field name="end_date"/>
        </group>
        <field name="task_ids">
          <tree editable="bottom">
            <field name="name"/>
            <field name="is_backlog"/>
          </tree>
        </field>
      </form>
    </field>
  </record>

  <!-- Tree View -->
  <record id="view_project_sprint_tree" model="ir.ui.view">
    <field name="name">project.sprint.tree</field>
    <field name="model">project.sprint</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="project_id"/>
        <field name="start_date"/>
        <field name="end_date"/>
      </tree>
    </field>
  </record>

  <!-- Action -->
  <record id="project_sprint_action" model="ir.actions.act_window">
    <field name="name">Sprints</field>
    <field name="res_model">project.sprint</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_project_sprint"
          name="Sprints"
          parent="project.menu_main_pm"
          action="project_sprint_action"
          sequence="20"/>
</odoo>
