<odoo>
  <record id="view_project_project_form_inherit_sprints" model="ir.ui.view">
    <field name="name">project.project.form.inherit.sprints</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Sprints">
          <field name="sprint_ids">
            <tree editable="bottom">
              <field name="name"/>
              
            </tree>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
