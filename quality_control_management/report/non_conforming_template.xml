<odoo>
  <template id="report_non_conforming_product_line">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
          <div class="page" style="font-size: 13px;">
            <!-- Title -->
            <h2 style="text-align: center;">Non-Conforming Product Log</h2>

            <!-- Table Section -->
            <table class="table table-sm" style="width: 100%; border: 1px solid black; border-collapse: collapse; margin-top: 10px;">
              <thead>
                <tr>
                  <th style="border: 1px solid black; width: 5%;">S.N</th>
                  <th style="border: 1px solid black; width: 15%;">Date</th>
                  <th style="border: 1px solid black;">Type of Product</th>
                  <th style="border: 1px solid black; width: 10%;">Quantity</th>
                  <th style="border: 1px solid black; width: 10%;">Type of Defect</th>
                  <th style="border: 1px solid black; width: 20%;">Correction</th>
                  <th style="border: 1px solid black; width: 20%;">Job Order No</th>
                  <th style="border: 1px solid black; width: 10%;">Shift</th>
                  <th style="border: 1px solid black; width: 20%;">Remarks</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="doc.non_conforming_lines" t-as="line" t-esc-options="{'widget': 'html'}">
                  <tr>
                    <td style="border: 1px solid black;"><t t-esc="line.sequence"/></td>
                    <td style="border: 1px solid black;"><t t-esc="doc.date.strftime('%d-%m-%Y') if doc.date else ''"/></td>
                    <td style="border: 1px solid black;"><t t-esc="line.product_type.display_name"/></td>
                    <td style="border: 1px solid black;"><t t-esc="line.quantity"/></td>
                    <td style="border: 1px solid black;"><t t-esc="line.defect_type"/></td>
                    <td style="border: 1px solid black;"><t t-esc="line.correction or ''"/></td>
                    <td style="border: 1px solid black;"><t t-esc="doc.job_order_no"/></td>
                    <td style="border: 1px solid black;"><t t-esc="dict({'morning':'Morning', 'afternoon':'Afternoon', 'night':'Night'}).get(doc.shift, '')"/></td>
                    <td style="border: 1px solid black;"><t t-esc="line.remark or ''"/></td>
                  </tr>
                </t>
              </tbody>
            </table>

            <!-- Footer Section -->
            <table style="width:100%; margin-top: 40px; font-size: 14px;">
              <tr>
                <td style="width: 50%; vertical-align: top;">
                  <strong>Prepared By:</strong><br/>
                  <t t-esc="doc.prepared_by.name"/><br/>
                  <div style="margin-top: 20px;">
                    <strong>Date:</strong>
                    <t t-esc="doc.date.strftime('%d %B %Y') if doc.date else ''"/><br/>
                    <strong>Signature:</strong><br/>
                    <span style="border-bottom: 1px solid black; display: inline-block; width: 70%; height: 20px;"></span>
                  </div>
                </td>
                <td style="width: 50%; vertical-align: top;">
                  <strong>Approved By:</strong><br/>
                  <t t-esc="doc.approved_by.name if doc.approved_by else ''"/><br/>
                  <div style="margin-top: 20px;">
                    <strong>Date:</strong>
                    <t t-esc="doc.date.strftime('%d %B %Y') if doc.date else ''"/><br/>
                    <strong>Signature:</strong><br/>
                    <span style="border-bottom: 1px solid black; display: inline-block; width: 70%; height: 20px;"></span>
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
