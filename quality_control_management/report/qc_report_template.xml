<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_qc_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align: center;">qc report</h2>
                        
                        <!-- Header Table -->
                        <table style="width: 100%; font-size: 13px;">
                            <tr>
                                <!-- Left Column -->
                                <td style="vertical-align: top; width: 50%; padding-right: 20px;">
                                    <table>
                                        <tr><td><strong>To:</strong></td><td><span t-field="doc.to"/></td></tr>
                                        <tr><td><strong>From:</strong></td><td><span t-field="doc.from_field"/></td></tr>
                                        <tr><td><strong>Product Type:</strong></td><td><span t-field="doc.product_type.name"/></td></tr>
                                    </table>
                                </td>
                                <!-- Right Column -->
                                <td style="vertical-align: top; width: 50%; padding-left: 20px;">
                                    <table>
                                        <tr><td><strong>Date:</strong></td><td><span t-field="doc.date"/></td></tr>
                                        <tr><td><strong>Rec. No:</strong></td><td><span t-field="doc.rec_no"/></td></tr>
                                        <tr><td><strong>Machine Line:</strong></td><td><span t-field="doc.machine_line"/></td></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Component Table -->
                        <table class="table table-sm" style="width: 100%; border: 1px solid black; border-collapse: collapse; margin-top: 20px; font-size: 13px;">
                            <thead>
                                <tr>
                                    <th style="border: 1px solid black; width: 5%;">S.N</th>
                                    <th style="border: 1px solid black; width: 35%;">Components</th>
                                    <th style="border: 1px solid black; width: 30%;">Weight (Kg.)/Batch 1</th>
                                    <th style="border: 1px solid black; width: 30%;">Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_weight" t-value="0"/>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td style="border: 1px solid black; text-align: center;"><span t-esc="line.sequence"/></td>
                                        <td style="border: 1px solid black; text-align: center;"><span t-esc="line.component"/></td>
                                        <td style="border: 1px solid black; text-align: center;"><span t-esc="line.weight"/></td>
                                        <td rowspan="2" style="border: 1px solid black; text-align: center;"><span t-esc="doc.remark or ''"/></td>
                                    </tr>
                                    <t t-set="total_weight" t-value="total_weight + line.weight"/>
                                </t>
                                <!-- Total  -->
                                <tr>
                                    <td colspan="2" style="border: 1px solid black; text-align: center;"><strong>Total</strong></td>
                                    <td style="border: 1px solid black; text-align: center;"><strong><span t-esc="total_weight"/></strong></td>
                                    <!-- <td style="border: 1px solid black;"></td> -->
                                </tr>
                            </tbody>
                        </table>

                        <!-- Footer Signature -->
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
