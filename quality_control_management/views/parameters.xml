<odoo>
<record id="view_parameter_form" model="ir.ui.view">
    <field name="name">parameter.parameter.form</field>
    <field name="model">parameter.parameter</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                     <!-- <field name="active"/> -->
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_parameter_tree" model="ir.ui.view">
    <field name="name">parameter.parameter.tree</field>
    <field name="model">parameter.parameter</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
        </tree>
    </field>
</record>


<record id="action_parameter" model="ir.actions.act_window">
    <field name="name">Parameters</field>
    <field name="res_model">parameter.parameter</field>
    <field name="view_mode">tree,form</field>
</record>



</odoo>