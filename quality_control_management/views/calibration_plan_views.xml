<odoo>
    <record id="view_calibration_form" model="ir.ui.view">
        <field name="name">calibration.plan.form</field>
        <field name="model">calibration.plan</field>
        <field name="arch" type="xml">
            <form string="Calibration Plan">
                <sheet>

                   <header>
                        <button name="action_prepared" 
                                type="object" 
                                string="Prepared" 
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_approve"
                                type="object" 
                                string="Approve" 
                                class="btn-success"
                                invisible="state != 'prepared'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,prepared,approved"/>
                    </header>

                    <div style="text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 15px;">
                       CALIBRATION PLAN
                    </div>
                    <group>
                        <field name="date"/>
                    </group>

                    <field name="calibration_lines">
                        <tree editable="bottom" string="Calibration Equipment List">
                            <field name="equipment_name"/>
                            <field name="serial_no"/>
                            <field name="capacity_range"/>
                            <field name="last_calibration"/>
                            <field name="calibration_frequency"/>
                            <field name="calibration_due_date"/>
                            <field name="calibration_party"/>
                            <field name="remarks"/>
                        </tree>
                    </field>

                    <group string="Authorization">
                        <group>
                            <field name="prepared_by" readonly="1"/>
                            
                        </group>
                        <group>
                            <field name="approved_by"/>
                            
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_calibration_tree" model="ir.ui.view">
        <field name="name">calibration.plan.tree</field>
        <field name="model">calibration.plan</field>
        <field name="arch" type="xml">
            <tree string="Calibration Plans">
                <field name="date"/>
                <field name="prepared_by"/>
                <field name="approved_by"/>
            </tree>
        </field>
    </record>

    <record id="action_calibration_plan" model="ir.actions.act_window">
        <field name="name">Calibration Plans</field>
        <field name="res_model">calibration.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record and track equipment calibration details and schedules.
            </p>
        </field>
    </record>

</odoo>
