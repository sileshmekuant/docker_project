<odoo>
    <!-- Inherit Partner Form to Add Regional Team -->
    <record id="view_partner_form_inherit_regional_team" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.regional.team</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="after">
                <field name="regional_team_id"/>
            </xpath>
        </field>
    </record>

    
</odoo>
