<odoo>
  <template id="leads_form_template" name="Leads Website Form">
    <t t-call="website.layout">
      <div class="container mt-5">
        <h2>Register Your Information</h2>
        <form action="/submit/leads" method="post" class="form-horizontal mt-4">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <div class="form-group">
            <label>Name</label>
            <input type="text" name="name" required="1" class="form-control"/>
          </div>

          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control"/>
          </div>

          <div class="form-group">
            <label>regional team</label>
            <input type="text" name="regional_team" class="form-control"/>
          </div>

          <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Submit</button>
          </div>
        </form>
      </div>
    </t>
  </template>
</odoo>
