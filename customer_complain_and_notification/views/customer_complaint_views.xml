
<odoo>
    <record id="view_customer_complaint_form" model="ir.ui.view">
        <field name="name">customer.complaint.form</field>
        <field name="model">customer.complaint</field>
        <field name="arch" type="xml">
            <form string="Customer Complaint Report">
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="sequence" readonly="1"/>
                        <field name="date"/>
                        <field name="complaint_received_by"/>
                        <field name="product_type"/>
                        <field name="complaint_description"/>
                        <field name="cause_of_complaint"/>
                        <field name="corrective_action_taken"/>
                    </tree>
                </field>
                <separator string="Complaint Details"/>
                <group col="3">
                    <group>
                        <field name="inspected_by_1"/>
                        <field name="inspected_by_2"/>
                    </group>
                   
                </group>

                
                
            </form>
        </field>
    </record>

    <record id="view_customer_complaint_report_tree" model="ir.ui.view">
      <field name="name">customer.complaint.report.tree</field>
      <field name="model">customer.complaint</field>
      <field name="arch" type="xml">
        <tree string="Customer Complaint Reports">
          <field name="inspected_by_1"/>
          <field name="inspected_by_2"/>
          
          <field name="approved_by"/>
        </tree>
      </field>
    </record>

    <record id="view_customer_complaint_action" model="ir.actions.act_window">
        <field name="name">Customer Complaint</field>
        <field name="res_model">customer.complaint</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_customer_complaint_root" name="Customer Complaint" parent="model_customer_complain_and_notification" />

    <menuitem id="menu_customer_complaint" name="Reports"
              parent="menu_customer_complaint_root"/>

    <menuitem id="menu_customer_complaint_main"
              name="Complaint Reports"
              parent="menu_customer_complaint"
              action="view_customer_complaint_action"/>
</odoo>
